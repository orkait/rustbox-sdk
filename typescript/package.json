{
  "name": "rustbox",
  "version": "0.6.0",
  "description": "Official TypeScript SDK for the Rustbox judge API - run and judge untrusted code in a kernel-enforced sandbox.",
  "keywords": [
    "rustbox",
    "judge",
    "code-execution",
    "untrusted-code",
    "sandbox"
  ],
  "homepage": "https://rustbox.sh/docs/sdks/typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orkait/rustbox-sdk.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/orkait/rustbox-sdk/issues"
  },
  "license": "MIT",
  "author": "Orkait <engineering@orkait.com>",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
