      "call": { "op": "get_result", "id": "3f1c2a9e-8b4d-4e2a-9c1f-5d6e7f8a9b0c" },
      "exchanges": [
        { "request": { "method": "GET", "path": "/api/result/3f1c2a9e-8b4d-4e2a-9c1f-5d6e7f8a9b0c" }, "response": { "status": 401, "shape": "error", "body": { "error": "invalid or missing API key" } } }
      ],
      "expect": { "error": { "kind": "auth", "status": 401 } }
    },
    {
      "name": "a rate limit carries Retry-After",
      "call": { "op": "submit", "language": "python", "code": "print(1)", "stdin": "" },
      "exchanges": [
        {
          "request": { "method": "POST", "path": "/api/submit", "query": { "wait": "false" }, "idempotency_key": "absent", "body": { "language": "python", "code": "print(1)", "stdin": "" } },
          "response": { "status": 429, "headers": { "Retry-After": "5" }, "shape": "error", "body": { "error": "too many in-flight sync submissions" } }
        }
      ],
      "expect": { "error": { "kind": "rate_limit", "status": 429, "retry_after_secs": 5 } }
    },
    {
      "name": "an API error carries the server's message",
      "call": { "op": "submit", "language": "cobol", "code": "DISPLAY 1.", "stdin": "" },
      "exchanges": [
        {
          "request": { "method": "POST", "path": "/api/submit", "query": { "wait": "false" }, "idempotency_key": "absent", "body": { "language": "cobol", "code": "DISPLAY 1.", "stdin": "" } },
          "response": { "status": 400, "shape": "error", "body": { "error": "unsupported language: cobol" } }
        }
      ],
      "expect": { "error": { "kind": "api", "status": 400, "message": "unsupported language: cobol" } }
    },
    {
      "name": "a body of the wrong shape is a decode error",
      "call": { "op": "get_result", "id": "3f1c2a9e-8b4d-4e2a-9c1f-5d6e7f8a9b0c" },
      "exchanges": [
        { "request": { "method": "GET", "path": "/api/result/3f1c2a9e-8b4d-4e2a-9c1f-5d6e7f8a9b0c" }, "response": { "status": 200, "body": { "id": "3f1c2a9e-8b4d-4e2a-9c1f-5d6e7f8a9b0c" } } }
      ],
      "expect": { "error": { "kind": "decode" } }
    }
  ]
}
